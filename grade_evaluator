# grade_evaluator.py

# Ask the user to enter a student's score
score = float(input("Enter the student's score (0-100): "))

# Check whether the score is within the valid range
if score < 0 or score > 100:
    print("Invalid score! Enter a score between 0 and 100.")

# Assign grades based on the score
elif score >= 90:
    print("Grade: A")

elif score >= 80:
    print("Grade: B")

elif score >= 70:
    print("Grade: C")

elif score >= 60:
    print("Grade: D")

elif score >= 50:
    print("Grade: E")

else:
    print("Grade: F")
